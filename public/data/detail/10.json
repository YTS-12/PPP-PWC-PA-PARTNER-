부문 현금창출단위 손상평가-핵심감사사항으로 결정한 이유연결실체는 보고기간말 현재 비금융자산에 대하여 손상징후의 존재 여부를 평가하여 자산손상을 시사하는 징후가 있을 때 손상평가를 수행합니다. 이때 개별 자산의 회수가능가액을 추정할 수 없다면 그 자산이 속하는 현금창출단위의 회수가능액을 산정합니다. 연결실체는 당기 중 현금창출단위의 실적 부진과 국내외 경기 위축 국면을 고려하여 해당 현금창출단위에 손상 징후가 존재한다고 판단하여 기업회계기준서 제1036호에 따라 손상검사를 수행하였습니다. 우리는 현금창출단위의 회수가능가액 평가에 포함된 미래현금흐름 추정의 복잡성 및 경영진의 유의적 판단 개입가능성을 고려하여 손상평가를 핵심감사사항으로 결정하였습니다.","primary":"20260320001361","contact":{"phone":"02-2104-7534","fax":"02-6713-7748","homepage":"www.sungho.net","ir":"","address":"서울특별시 금천구 가산디지털1로 205-15 에스에이치드림타워 1301호, 1302호, 1401호"},"fin":{"basis":"CFS","currency":"KRW","assets":581089727261,"revenue":231577035770,"op":7551422708,"rcept":"20260320001361"},"finx":null,"hist":[[2025,"이촌회계법인","20260320001361"],[2024,"이촌회계법인","20250321001917"],[2023,"정동 회계법인","20240319000867"],[2022,"정동회계법인","20230317000886"],[2021,"정동회계법인","20220321001056"],[2020,"이촌회계법인","20210319001221"]],"filings":[{"cat":"MNA","t":"[첨부정정]주요사항보고서(회사합병결정)","d":"2026-04-30","r":"20260430000794"},{"cat":"MNA","t":"주요사항보고서(타법인주식및출자증권양수결정)","d":"2026-04-15","r":"20260415000002"},{"cat":"MNA","t":"[기재정정]주요사항보고서(타법인주식및출자증권양수결정)","d":"2026-01-05","r":"20260105000427"}],"h":[{"id":"PA3","ev":"주요사항보고서(회사합병결정) · 2026-04-30 외 2건","d":"2026-04-30","k":"20260430000794","r":"20260430000794","value":null},{"id":"IC3","ev":"주요사항보고서(회사합병결정) · 2026-04-30 외 2건","d":"2026-04-30","k":"20260430000794","r":"20260430000794","value":null},{"id":"IC1","ev":"연결 자산총계 5,811억 · 연결 작성 → 2029 사업연도 연결 내부회계 감사(현행 일정, 연결 자산 근사)","d":"","k":"FIN:00317210:IC1","r":"20260320001361","value":null},{"id":"IF3","ev":"연결 자산총계 5,811억 · 연결 작성","d":"","k":"FIN:00317210:IF3","r":"20260320001361","value":null}],"notes":[]},"00273110":{"c":"00273110","n":"에스티큐브","s":"052020","m":"KOSDAQ","dartName":"(주)에스티큐브","ceo":"정현진","listed":"2001-07-05","ig":"유통·소비재","ic":"465","accMt":"12","au":"삼일회계법인","auSrc":"2025 사업보고서","ag":"SAMIL","opinion":"적정의견","kam":"수익인식 발생사실","primary":"20260318001399","contact":{"phone":"02-551-3370","fax":"02-551