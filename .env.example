# ───────── PA Insight 환경변수 ─────────
# 이 파일을 복사해 .env를 만들고 값을 채운다:  copy .env.example .env
# .env는 깃허브에 올리지 않는다(.gitignore에 포함). 키를 채팅·문서·코드에 붙여 넣지 말 것.
# Supabase service_role 키는 이 프로젝트에서 쓰지 않는다. 어디에도 넣지 않는다.

# 1) OpenDART 인증키 — = 뒤에 붙여 넣기 (따옴표 없이)
#    추가 수집 스크립트(npm run collect:*)에서만 쓰고, 웹 화면 코드에는 들어가지 않는다. Vercel에 넣지 않는다.
DART_API_KEY=

# 2) 기존 수집본 폴더 (08_상장기업전체_웹앱용_기업데이터.json이 있는 폴더)
#    npm run data:build 를 돌리는 PC에서만 필요하다. 수집만 할 때는 비워 둬도 된다(data/universe.json 사용).
#    예) DATA_DIR=C:\Users\<사용자>\Desktop\상장기업자료_최종검토본
DATA_DIR=

# 3) Supabase (로그인·개인 맞춤 저장)
#    Supabase 대시보드 → Project Settings → API에서 Project URL과 anon(publishable) 키를 복사
#    비워 두면 '로그인 없이 둘러보기'만 동작한다.
#    NEXT_PUBLIC_ 값은 빌드할 때 화면 코드에 들어가므로, Vercel에서 바꾸면 다시 배포해야 반영된다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 4) Vercel 크론 확인용 비밀값 — 영문·숫자 20자 이상 아무 문자열
#    배포할 때 Vercel 환경변수에도 같은 값을 넣는다. (Vercel에는 3)·4)의 3개만 넣는다)
CRON_SECRET=
